NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_ROOT=storage
MAX_SOURCE_VIDEO_MB=200
# Optional. Leave empty to use imageio-ffmpeg, or set to /usr/bin/ffmpeg on Linux.
FFMPEG_BINARY=

# Authorized video source service.
# The API must expose POST {AUTH_SOURCE_API_BASE_URL}/resolve
# Request body: {"platform":"douyin|kuaishou","sourceUrl":"https://..."}
# Response body: {"downloadUrl":"https://authorized-cdn.example/video.mp4","title":"optional"}
AUTH_SOURCE_API_BASE_URL=
AUTH_SOURCE_API_TOKEN=
AUTH_SOURCE_TIMEOUT_SECONDS=30
ALLOW_PRIVATE_SOURCE_URLS=false
